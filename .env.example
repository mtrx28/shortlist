# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret that scheduled jobs send to /api/cron/* endpoints
CRON_SECRET=

# Razorpay (test mode keys only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Public URL of the app (http://localhost:3000 for local development)
NEXT_PUBLIC_APP_URL=http://localhost:3000
