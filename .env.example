# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this to the browser. Used for event logging and later jobs.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret that scheduled jobs send to /api/cron/* endpoints (weekly drop,
# keep-alive) as "Authorization: Bearer <secret>". If it is empty, those
# endpoints refuse every request. Use a long random string, for example:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the same value as the CRON_SECRET repository secret on GitHub, next to
# APP_URL (the public address of the deployed app, for example https://example.vercel.app).
CRON_SECRET=

# Payments for Shortlist Plus.
#   PAYMENT_PROVIDER   "simulated" (a fake checkout page, no account needed) or
#                      "razorpay". Leave empty: Razorpay is used when BOTH keys
#                      below are set, the simulated checkout when NEITHER is.
#                      Setting only one key is an error (the app will not guess).
#   RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET
#                      Razorpay TEST mode keys only (the id starts with rzp_test_).
#                      Razorpay dashboard, in Test Mode: Account and Settings >
#                      API keys. The secret is server only; never commit it.
#   RAZORPAY_WEBHOOK_SECRET
#                      The secret you type when adding the webhook in the Razorpay
#                      dashboard (Webhooks > Add, URL <app>/api/webhooks/razorpay,
#                      events payment.captured, order.paid, payment.failed).
#   ALLOW_LIVE_PAYMENTS
#                      Must stay false. A key starting rzp_live_ is refused unless
#                      this is exactly "true". Real money is not part of this
#                      project; do not turn this on for the submission.
PAYMENT_PROVIDER=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ALLOW_LIVE_PAYMENTS=false

# Public URL of the app (http://localhost:3000 for local development)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret key for hashing pH IDs (HMAC). Server only. Use a long random string,
# for example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it later breaks matching of old hashes, so keep it stable.
ELITMUS_HASH_SECRET=

# Demo only: set to true to mark pH ID requests as verified straight away.
# Leave unset (or false) in production.
DEMO_AUTO_VERIFY=false

# Demo data only (npm run seed): the shared password for every demo login.
# Pick something of at least 8 characters. Never commit the real value.
DEMO_PASSWORD=

# Demo only: set to true to show the "Demo controls" panel on chats that involve a
# demo account (it moves a chat's clock forward so the 48 hour reminder, the day-3
# decision and expiry can be seen without waiting). Off unless exactly "true".
# Never turn this on for a deployment with real members.
DEMO_CONTROLS=false

# Secret mixed into the scrambled code kept in the small safety record when a
# reported person deletes their account. Server only, at least 16 characters.
# If empty, ELITMUS_HASH_SECRET is used; if neither is set, account deletion
# refuses to run. Changing it later only affects records made afterwards.
SAFETY_HASH_SECRET=
